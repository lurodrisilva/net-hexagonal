      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "kafka_server_kafkarequesthandlerpool_requesthandleravgidlepercent{strimzi_io_cluster=\"hex-scaffold-loadtest\"} * 100",
