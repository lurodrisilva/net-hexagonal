      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (kafka_broker_id) (rate(kafka_server_brokertopicmetrics_bytesin_total{strimzi_io_cluster=\"hex-scaffold-loadtest\"}[1m]))",
