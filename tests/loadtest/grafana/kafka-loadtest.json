      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "kafka_writer_error_count{tier=~\"$tier\",repo=~\"$repo\",runId=~\"$runId\"}",
          "legendFormat": "errors",
          "refId": "A"
        }
      ],
      "title": "Producer errors (must be 0)",
      "type": "timeseries"
    },
